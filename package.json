{
  "name": "fude",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --experimental-strip-types --no-warnings scripts/fetch-art.mjs && node scripts/fetch-models.mjs && node scripts/fetch-props.mjs && node scripts/fetch-textures.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "fetch-strokes": "node scripts/fetch-strokes.mjs",
    "art:process": "node --experimental-strip-types --no-warnings scripts/process-art.mjs",
    "art:fetch": "node --experimental-strip-types --no-warnings scripts/fetch-art.mjs"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.6"
  }
